# Data: input corpora (large, re-downloadable) + optuna sweep state
/data/

# Machine output: runs/ = transient instrument snapshots. results/ (the
# per-version headline summaries, incl. the ledger HPO reads its tie band
# from) is tracked. Anchored.
/runs/

# Scratch (mockups, one-off previews)
/tmp/

# Exploration scratch: large regenerable MAGEMin inputs/outputs (results/ stays tracked)
explorations/**/work/

# Models
checkpoints/
*.pt
*.pth

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
# anchored: unanchored build/ would swallow new files under scripts/build/
/build/
/dist/

# OS
.DS_Store

# Papers: the PDFs stay out, the bibliography and its claim map are tracked.
# Ignoring the contents rather than the directory -- git does not descend into
# an excluded directory, so a `!literature/*.bib` negation under a bare
# `literature/` never fires.
literature/*
!literature/*.bib
!literature/*.md