# Data: input corpora (large, re-downloadable). The benchmark CSVs and the
# corpus excerpt are tracked exceptions.
/data/

# Machine output: runs/ = transient instrument snapshots. Anchored.
/runs/

# Models: the two production checkpoints are tracked exceptions.
checkpoints/
*.pt
*.pth

# Figure output: fig_*.py drops PDFs (and eyeball PNGs) at figures/ root, the
# fit scripts drop diagnostic PNGs in figures/data/. The tracked inputs are
# the CSVs and JSONs.
figures/**/*.pdf
figures/**/*.png

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
# anchored: unanchored build/ would swallow new files under scripts/build/
/build/
/dist/

# OS
.DS_Store
